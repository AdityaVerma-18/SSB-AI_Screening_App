{
  "expo": {
    "name": "SSB AI Screening",
    "slug": "ssb-ai-screening-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#121317"
    },
